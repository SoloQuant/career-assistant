# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/career_assistant

# JWT密钥（用于用户认证）
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 服务端口
PORT=3001

# AI API配置（可选，用于AI对话、任务智能拆分、模拟面试等功能）
# 不配置也能正常使用其他功能
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1

# 新闻数据源配置（可选）
NEWS_API_KEY=

# 环境模式
NODE_ENV=development
